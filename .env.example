# Database credentials (used by both postgres container and backend)
SPRING_DATASOURCE_USERNAME=fleet_user
SPRING_DATASOURCE_PASSWORD=your_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (no trailing slash)
FRONTEND_URL=http://localhost

# JWT secrets (min 32 characters each)
ONBOARDING_JWT_SECRET=your_secret_key_at_least_32_chars_long
AUTH_JWT_SECRET=your_auth_secret_key_at_least_32_chars_long

# Google Maps API keys
# Frontend key — restrict to your domain in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Backend key — used by /api/locations/geocode (restrict to server IP)
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key

# Cloudinary (image uploads) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SendGrid (email notifications) — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key
# Sender address verified in SendGrid (Sender Authentication)
MAIL_FROM=noreply@yourdomain.com

# Auction grace period: hours after auctionClosesAt before job expires (default: 24)
AUCTION_GRACE_PERIOD_HOURS=24
