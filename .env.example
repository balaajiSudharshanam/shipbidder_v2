# Database credentials (used by both postgres container and backend)
SPRING_DATASOURCE_USERNAME=fleet_user
SPRING_DATASOURCE_PASSWORD=your_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (no trailing slash)
FRONTEND_URL=http://localhost

# JWT secrets (min 32 characters each)
ONBOARDING_JWT_SECRET=your_secret_key_at_least_32_chars_long
AUTH_JWT_SECRET=your_auth_secret_key_at_least_32_chars_long
